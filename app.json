{
  "expo": {
    "name": "Scan Demo",
    "slug": "myapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28
          }
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photo library to import documents."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save scanned documents to your photo library."
        }
      ],
      "expo-sharing",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "zh-Hans",
              "zh-Hant",
              "ja",
              "ko",
              "fr",
              "de",
              "es",
              "pt"
            ],
            "android": [
              "en",
              "zh-Hans",
              "zh-Hant",
              "ja",
              "ko",
              "fr",
              "de",
              "es",
              "pt"
            ]
          }
        }
      ],
      "expo-font"
    ],
    "locales": {
      "en": "./locales/en.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "zh-Hant": "./locales/zh-Hant.json",
      "ja": "./locales/ja.json",
      "ko": "./locales/ko.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "es": "./locales/es.json",
      "pt": "./locales/pt.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.scandemo",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan Demo uses the camera to scan documents.",
        "NSPhotoLibraryUsageDescription": "Scan Demo accesses your photo library so you can import images to scan.",
        "NSPhotoLibraryAddUsageDescription": "Scan Demo saves scanned documents to your photo library."
      }
    },
    "android": {
      "package": "com.example.scandemo",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
